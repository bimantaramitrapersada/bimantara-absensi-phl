{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bimantara-absensi-phl",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
 
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  }


  "observability": {
    "enabled": true
  }
}
